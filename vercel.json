{
  "headers": [
    {
      "source": "/assets/opt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(avif|webp|jpg|jpeg|png|svg|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/mobile-menu.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quienes-somos",
      "destination": "/quienes-somos.html"
    },
    {
      "source": "/productos",
      "destination": "/productos.html"
    },
    {
      "source": "/calidad",
      "destination": "/calidad.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/llave-en-mano",
      "destination": "/llave-en-mano.html"
    },
    {
      "source": "/crea-tu-producto",
      "destination": "/desarrolla-tu-producto.html"
    },
    {
      "source": "/cotizador",
      "destination": "/cotizador.html"
    }
  ]
}
