{
  "headers": [
    {
      "source": "/assets/creamy/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quienes-somos",
      "destination": "/quienes-somos.html"
    },
    {
      "source": "/productos",
      "destination": "/productos.html"
    },
    {
      "source": "/calidad",
      "destination": "/calidad.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/llave-en-mano",
      "destination": "/llave-en-mano.html"
    },
      {
      "source": "/crea-tu-producto",
      "destination": "/desarrolla-tu-producto.html"
    },
      {
      "source": "/cotizador",
      "destination": "/cotizador.html"
    }
  ]
}
