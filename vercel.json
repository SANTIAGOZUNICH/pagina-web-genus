{
  "functions": {
    "api/creamy-v2/chat.js": {
      "maxDuration": 60,
      "includeFiles": "backend/creamy-v2/**"
    },
    "api/creamy-v2/health.js": {
      "includeFiles": "backend/creamy-v2/**"
    },
    "api/creamy-v2/debug.js": {
      "maxDuration": 30,
      "includeFiles": "backend/creamy-v2/**"
    },
    "api/creamy-v2/event.js": {
      "maxDuration": 15,
      "includeFiles": "backend/creamy-v2/**"
    },
    "api/creamy-v2/sheets-debug.js": {
      "maxDuration": 15,
      "includeFiles": "backend/creamy-v2/**"
    }
  },
  "headers": [
    {
      "source": "/assets/creamy/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/creamy-v2/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles-polish.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/creamy/creamy.js",
      "destination": "/api/creamy/widget"
    },
    {
      "source": "/assets/creamy/creamy.css",
      "destination": "/api/creamy/widget-css"
    },
    {
      "source": "/quienes-somos",
      "destination": "/quienes-somos.html"
    },
    {
      "source": "/productos",
      "destination": "/productos.html"
    },
    {
      "source": "/calidad",
      "destination": "/calidad.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/llave-en-mano",
      "destination": "/llave-en-mano.html"
    },
      {
      "source": "/crea-tu-producto",
      "destination": "/desarrolla-tu-producto.html"
    },
      {
      "source": "/cotizador",
      "destination": "/cotizador.html"
    }
  ]
}
